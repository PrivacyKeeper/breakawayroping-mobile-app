# Copy to .env and fill in. The Supabase pair are public client keys; RLS is
# what protects the data, not the secrecy of these values.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Maps. Without these the arena map degrades to a coordinate card and
# a directions link — dropping a pin still works, because reverse geocoding
# uses the OS geocoder and needs no key.
# Restrict each key to its platform and to the Maps SDK.
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=

# Weather. Leave the key blank and the widget renders nothing at all, which
# is the intended behaviour rather than a failure.
# Provider: openweather | weatherapi | tomorrow
EXPO_PUBLIC_WEATHER_PROVIDER=openweather
EXPO_PUBLIC_WEATHER_API_KEY=
